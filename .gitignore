**/secrets/
**/credentials/
*.secret
*.token
*.credentials
.tfstate
.tfstate.*
.terraform/
.aws/
.ssh/

# Private keys, TLS certificates, keystores, and local TLS setup.
certs/
**/certs/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
id_rsa
id_ed25519

# Local database files, dumps, backups, and logs.
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.bak
*.log
logs/
**/logs/

# Dependencies, build output, test and tool caches.
node_modules/
